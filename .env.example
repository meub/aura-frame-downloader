# -----------------------------------------------------------------------
# Aura Frame Downloader – Container environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# -----------------------------------------------------------------------

# --- Aura credentials ---------------------------------------------------
# In production (ECS) store these in AWS Secrets Manager and reference them
# via the ECS task definition `secrets:` block, NOT `environment:`.
AURA_EMAIL=you@example.com
AURA_PASSWORD=your-aura-password

# --- Frame configuration ------------------------------------------------
# JSON array.  Each object requires: name, frame_id, s3_prefix.
# frame_id: the UUID shown in the Aura app → Settings → Frame ID.
# s3_prefix: the S3 "folder" prefix for this frame (no leading/trailing slash).
AURA_FRAMES='[{"name":"Living Room","frame_id":"replace-with-your-frame-id","s3_prefix":"living-room"}]'

# Multiple frames example:
# AURA_FRAMES='[
#   {"name":"Living Room","frame_id":"aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee","s3_prefix":"living-room"},
#   {"name":"Bedroom",    "frame_id":"ffffffff-0000-1111-2222-333333333333","s3_prefix":"bedroom"}
# ]'

# --- S3 destination -----------------------------------------------------
S3_BUCKET=my-aura-backup
AWS_DEFAULT_REGION=us-east-1

# --- AWS credentials (local testing only) -------------------------------
# When running in ECS, leave these commented out — the task IAM role is used.
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# --- Optional settings --------------------------------------------------
# Set to "true" to organise photos into year sub-folders within each prefix.
ORGANIZE_BY_YEAR=false

# Set to "true" for a local smoke test: contacts the Aura API and reports
# photo counts only — no downloads, no S3 writes, no AWS credentials needed.
# COUNT_ONLY=true
